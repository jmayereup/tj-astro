# NOTE: .env is for local development only.
# For production deployments (e.g. Cloudflare Pages), configure these environment variables
# in Cloudflare Pages Settings -> Environment Variables / Secrets.

# Ghost API configuration
GHOST_CONTENT_API_KEY=your_ghost_content_api_key
GHOST_API_URL=https://your-ghost-domain.com

# PocketBase configuration
PUBLIC_POCKETBASE_URL=https://your-pocketbase-domain.com

# PocketBase Admin/Superuser credentials (required if records are restricted)
POCKETBASE_EMAIL=your_admin_email@example.com
POCKETBASE_PASSWORD=your_admin_password

# Google Apps Script Webhook Submission URL for custom web components (<tj-*>)
PUBLIC_SUBMISSION_URL=https://script.google.com/macros/s/your_script_id/exec


