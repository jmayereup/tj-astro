---
import Layout from "./Layout.astro";
import WorksheetCard from "../components/WorksheetCard.astro";
import InfiniteScroll from "../components/InfiniteScroll.astro";
import LevelFilter from "../components/LevelFilter.astro";

interface Props {
  page: any;
  lang: string;
  displayLang: string;
  title?: string;
  description?: string;
  level?: string;
  tag?: string;
  filterLabel?: string;
}

const { 
  page, 
  lang, 
  displayLang, 
  title, 
  description, 
  level, 
  tag, 
  filterLabel 
} = Astro.props;

const posts = page.data || [];

// Default SEO Title
const seoTitle = title || `Teacher Jake ${filterLabel ? filterLabel + ' - ' : ''}${displayLang + ' '}${level ? ' ' + level.toUpperCase() : ''} (Page ${page.currentPage})`;

// Default SEO Description
const seoDescription = description || `Browse our collection of interactive ${displayLang} learning materials, reading exercises, and quizzes.`;

// Default Page Title (h1)
const pageTitle = filterLabel 
  ? `${displayLang} ${filterLabel}` 
  : `${displayLang} Worksheets`;

// Default Page Description (p)
const pageDescription = `Browse our collection of interactive ${displayLang + ' '}  ${filterLabel ? filterLabel.toLowerCase() : 'language'} learning materials.`;
---

<Layout
  title={seoTitle}
  currentLang={lang}
  currentTag={tag}
  description={seoDescription}
>
  <div class="px-4">
    <div class="mb-4 text-center pt-4">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-[#06422f] tracking-tight capitalize">
        <slot name="title">{pageTitle}</slot>
      </h1>
      <p class="text-lg text-[#4a5568] max-w-2xl mx-auto">
        <slot name="description">{pageDescription}</slot>
      </p>
      
      {tag === 'book' && (
        <div class="mt-6 max-w-2xl mx-auto text-left">
          <a 
            href="https://books.teacherjake.com/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group flex items-center gap-4 p-4 rounded-2xl border border-emerald-100 bg-emerald-50/50 hover:bg-white hover:shadow-md transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div class="grow">
              <h3 class="font-bold text-emerald-950 text-base">Ebooks</h3>
              <p class="text-emerald-800 text-sm">Read and download ebooks graded by CEFR levels.</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400 group-hover:text-emerald-600 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}
    </div>

    <div class="mb-4">
      <LevelFilter 
        currentLang={lang} 
        currentLevel={level || "all"} 
        currentTag={tag}
      />
      <slot name="extra-filters" />
    </div>

    {posts.length === 0 ? (
      <div class="bg-amber-50 text-amber-800 p-6 rounded-xl border border-amber-200 text-center shadow-sm">
        <slot name="empty-state">
          <p class="text-lg font-medium">
            No {displayLang} {level ? level.toUpperCase() : ''} {filterLabel || 'worksheets'} found.
          </p>
          <p class="mt-2 opacity-80">Check back later for more content.</p>
        </slot>
      </div>
    ) : (
      <div
        id="card-grid"
        class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        transition:name="content-grid"
      >
        {posts.map((post: any) => (
          <WorksheetCard post={post} lang={lang} />
        ))}
      </div>
    )}

    <InfiniteScroll nextUrl={page.url.next} />
  </div>
</Layout>
