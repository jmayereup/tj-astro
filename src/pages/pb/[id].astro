---
import Layout from "../../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { getPb } from "../../lib/pocketbase";
import {
  resolveLocalizedAsset,
  resolveLocalizedImage,
} from "../../utils/assetResolver";
import { transformPbContent } from "../../utils/contentTransformer";
import { renderContentAsHtml } from "../../utils/serialization";
import ShareButtons from "../../components/ShareButtons.astro";
import PostTags from "../../components/PostTags.astro";
import Recommendations from "../../components/Recommendations.astro";
import { getAllPosts } from "../../lib/ghost-utils";
import { mapPbRecord } from "../../lib/pb-worksheet-mapper";

export async function getStaticPaths() {
  // Defined inside getStaticPaths so Vite's prerender bundler captures them
  const categoryGroups = [
    ["bilingual", "lbl-reader", "blb"],
    ["focused-reading", "chapter-book", "book"],
    ["information-gap", "pronunciation", "speaking"],
    ["listening"],
    ["grammar-game", "word-blaster", "grammar-hearts", "speed-review", "quiz-element", "quiz"],
    ["worksheet"]
  ];

  function getCategoryGroup(cat: string): string[] {
    cat = cat.toLowerCase();
    for (const group of categoryGroups) {
      if (group.includes(cat)) return group;
    }
    return [cat];
  }
  try {
    const ghostPosts = await getAllPosts({ include: ["tags"] });
    const normalizedGhost = ghostPosts.map((p) => ({
      ...p,
      type: "gh",
      source: "ghost",
    }));

    const pb = await getPb();
    const worksheets = await pb.collection("worksheets").getFullList();
    const normalizedPb = await Promise.all(worksheets.map(mapPbRecord));

    // Lesson types that render via htmlCompiled + external web components.
    const newLessonTypes = [
      "lbl-reader",
      "grammar-hearts",
      "listening",
      "speed-review",
      "chapter-book",
      "pronunciation",
      "quiz-element",
      "information-gap",
    ];

    // Warn about new lesson types missing htmlCompiled so data issues surface clearly.
    for (const ws of worksheets) {
      if (
        newLessonTypes.includes(ws.lessonType || "") &&
        !ws.htmlCompiled
      ) {
        console.warn(
          `[pb/[id]] worksheet ${ws.id} ("${ws.title}") has lessonType "${ws.lessonType}" but no htmlCompiled — page will render empty.`
        );
      }
    }

    const allNormalized = [...normalizedGhost, ...normalizedPb];

    return worksheets.flatMap((worksheet, idx) => {
      const lang = (worksheet.language || "english").toLowerCase();
      const category = worksheet.lessonType?.toLowerCase();

      const recommendations = allNormalized
        .filter((p) => {
          if (p.id === worksheet.id) return false;

          const pTags =
            p.tags?.map((t: any) => t.slug || t.name?.toLowerCase()) || [];
          const sameLang = pTags.includes(lang) || p.language === lang;

          let sameCategory = false;
          if (category) {
            const group = getCategoryGroup(category);
            sameCategory = pTags.some((t: string) => group.includes(t)) ||
                           (p.lessonType && group.includes(p.lessonType.toLowerCase()));
          }

          return sameLang && sameCategory;
        })
        .sort((a, b) => {
          const da = new Date(a.published_at || a.created_at || 0).getTime();
          const db = new Date(b.published_at || b.created_at || 0).getTime();
          return db - da;
        })
        .slice(0, 3);

      const mapped = normalizedPb[idx];
      return [
        {
          params: { id: worksheet.id },
          props: { worksheet, mappedWorksheet: mapped, recommendations },
        },
        {
          params: { id: mapped.slug },
          props: { worksheet, mappedWorksheet: mapped, recommendations },
        },
      ];
    });
  } catch (error) {
    console.warn(
      "Failed to fetch from Pocketbase. Make sure your Pocketbase server is running.", error
    );
    return [];
  }
}

const { worksheet, mappedWorksheet, recommendations = [] } = Astro.props as {
  worksheet: any;
  mappedWorksheet: any;
  recommendations: any[];
};

// mappedWorksheet was pre-computed in getStaticPaths — no second mapPbRecord call needed.

// Lesson types that render via pre-compiled htmlCompiled + external web components.
// Their `content` field is not JSON (often raw HTML/text), so it must NOT be JSON.parsed.
const newLessonTypes = [
  "lbl-reader",
  "grammar-hearts",
  "listening",
  "speed-review",
  "chapter-book",
  "pronunciation",
  "quiz-element",
  "information-gap",
];
const isNewLessonType = newLessonTypes.includes(worksheet.lessonType || "");

let content: any;
if (isNewLessonType) {
  // New lesson types render htmlCompiled only; `content` is unused at render time.
  content = {};
} else if (typeof worksheet.content === "string") {
  try {
    content = JSON.parse(worksheet.content || "{}");
  } catch (e) {
    console.warn(
      `[pb/[id]] worksheet ${worksheet.id} ("${worksheet.title}") has unparseable content field — falling back to {}.`
    );
    content = {};
  }
} else {
  content = worksheet.content || {};
}

// Transform content at build time (optimizes images)
content = await transformPbContent(content, worksheet.id);

let imageUrl: any = undefined;
let imageObj: any = undefined;
if (worksheet.image) {
  const resolved = await resolveLocalizedImage(
    "pb",
    worksheet.id,
    worksheet.image
  );
  if (resolved && typeof resolved !== "string") {
    imageObj = resolved;
    const optimized = await getImage({ src: resolved, width: 1200 });
    imageUrl = optimized.src;
  } else if (resolved) {
    imageUrl = resolved;
  } else {
    imageUrl = `${import.meta.env.PUBLIC_POCKETBASE_URL}/api/files/worksheets/${worksheet.id}/${worksheet.image}`;
  }
}

let audioFileUrl = worksheet.audioFile
  ? resolveLocalizedAsset("pb", worksheet.id, worksheet.audioFile, worksheet.collectionId)
  : undefined;

const parsedLesson = {
  ...worksheet,
  content,
  image: imageUrl,
  audioFile: audioFileUrl,
};

const currentLang = (worksheet.language || "English").toLowerCase();
const componentScriptMap: Record<string, string> = {
  'tj-info-gap': 'https://scripts.teacherjake.com/tj-info-gap.js',
  'tj-chapter-book': 'https://scripts.teacherjake.com/tj-chapter-book.js',
  'tj-quiz-element': 'https://scripts.teacherjake.com/tj-quiz-element.js',
  'tj-speed-review': 'https://scripts.teacherjake.com/tj-speed-review.js',
  'tj-grammar-hearts': 'https://scripts.teacherjake.com/tj-grammar-hearts.js',
  'tj-reader': 'https://scripts.teacherjake.com/tj-reader.js',
  'tj-listening': 'https://scripts.teacherjake.com/tj-listening.js',
  'tj-pronunciation': 'https://scripts.teacherjake.com/tj-pronunciation.js'
};

const lessonTypeToComponentMap: Record<string, string> = {
  'information-gap': 'tj-info-gap',
  'chapter-book': 'tj-chapter-book',
  'quiz-element': 'tj-quiz-element',
  'speed-review': 'tj-speed-review',
  'grammar-hearts': 'tj-grammar-hearts',
  'lbl-reader': 'tj-reader',
  'listening': 'tj-listening',
  'pronunciation': 'tj-pronunciation'
};

const scriptsToLoad = new Set<string>();

// 1. Detect components by lessonType
const componentName = lessonTypeToComponentMap[worksheet.lessonType || ""];
if (componentName && componentScriptMap[componentName]) {
  scriptsToLoad.add(componentScriptMap[componentName]);
}

// 2. Detect additional components embedded in htmlCompiled (only for new lesson types)
// Skipped for "worksheet" type to prevent picking up stale tj-pocketbase-worksheet references.
if (isNewLessonType && worksheet.htmlCompiled) {
  for (const [tag, scriptUrl] of Object.entries(componentScriptMap)) {
    if (worksheet.htmlCompiled.includes(`<${tag}`)) {
      scriptsToLoad.add(scriptUrl);
    }
  }
}

const finalScripts = Array.from(scriptsToLoad);
const contentFallbackHtml = renderContentAsHtml(content);

const lessonTypeLower = (worksheet.lessonType || "").toLowerCase();
const pbTagsLower = (worksheet.tags || []).map((t: any) => 
  (typeof t === "string" ? t : t.name || t.slug || "").toLowerCase()
);
const hideTopImage = [
  "worksheet", 
  "worksheets", 
  "focused-reading", 
  "focused reader", 
  "lbl-reader"
].includes(lessonTypeLower) || pbTagsLower.some((t: string) => 
  ["worksheet", "worksheets", "focused-reading", "focused reader", "lbl-reader"].includes(t)
);
---

<Layout
  title={`${worksheet?.title || "Teacher Jake"}`}
  currentLang={currentLang}
  currentTag="worksheet"
  description={worksheet?.seo || worksheet?.description}
  image={imageObj || imageUrl}
  article={true}
>
  {isNewLessonType && (
    <Fragment slot="head">
      {finalScripts.map(scriptUrl => (
        <script is:inline type="module" src={scriptUrl} defer crossorigin="anonymous"></script>
      ))}
    </Fragment>
  )}
  <div id="webview-warning" class="hidden mb-6 mx-auto max-w-6xl">
    <div
      class="bg-amber-50 border border-amber-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center gap-4 shadow-sm animate-in fade-in slide-in-from-top-4 duration-500"
    >
      <div
        class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 shrink-0"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>
      <div class="grow text-center sm:text-left">
        <h3 class="text-amber-900 font-bold text-lg mb-1">
          In-App Browser Warning
        </h3>
        <p class="text-amber-800 text-sm leading-relaxed">
          Some features (like Text-to-Speech) may not work correctly in this
          browser. For the best experience, please open this page in Chrome or
          your default browser.
        </p>
      </div>
      <a
        id="browser-intent-link"
        href="#"
        class="whitespace-nowrap bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 shadow-md hover:shadow-lg active:scale-95 text-center w-full sm:w-auto"
      >
        Open in Browser
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      const ua = navigator.userAgent;
      const isAndroid = /Android/i.test(ua);
      const isWebView =
        /wv/i.test(ua) ||
        (isAndroid &&
          /Version\/[\d.]+/i.test(ua) &&
          !/Chrome\/[\d.]+/i.test(ua));

      if (isAndroid && isWebView) {
        const warning = document.getElementById("webview-warning");
        if (warning) {
          warning.classList.remove("hidden");

          const intentLink = document.getElementById("browser-intent-link");
          if (intentLink) {
            // Construct Android Intent link to open in external browser
            const url = window.location.href;
            const cleanUrl = url.replace(/^https?:\/\//, "");
            intentLink.href = `intent://${cleanUrl}#Intent;scheme=https;action=android.intent.action.VIEW;end`;
          }
        }
      }
    })();
  </script>

  <article
    class="relative max-w-6xl mx-auto bg-white sm:rounded-2xl sm:shadow-sm"
    data-pagefind-body
  >
    <div
      class="flex flex-col justify-center sm:flex-row sm:justify-between sm:space-between sm:items-center w-full pt-6 px-4 sm:px-8 lg:px-12 pr-12 gap-2"
    >
      <div class="flex w-full justify-center sm:justify-start">
        <ShareButtons
          title={worksheet.title}
          description={worksheet.seo || worksheet.description}
        />
      </div>
      <div class="flex mr-6 w-full justify-center sm:justify-end">
        <PostTags post={mappedWorksheet} lang={currentLang} />
      </div>
    </div>
  <button
    onclick="window.history.length > 1 ? window.history.back() : window.location.href = '/';"
    class="flex justify-center absolute top-2 right-2 w-8 h-8 items-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-800 transition-colors"
    title="Close Lesson"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><line x1="18" y1="6" x2="6" y2="18"></line><line
        x1="6"
        y1="6"
        x2="18"
        y2="18"></line>
    </svg>
  </button>
    {!hideTopImage && (imageObj ? (
        <div class="w-full max-h-[400px] bg-slate-50 sm:rounded-2xl sm:shadow-md mx-auto my-4 sm:my-8 overflow-hidden flex justify-center">
          <Image 
            src={imageObj} 
            alt={worksheet.title || ""} 
            width={1200}
            height={630}
            data-pagefind-meta="image[src]"
            class="max-h-[400px] object-contain" 
          />
        </div>
    ) : imageUrl && (
        <div class="w-full max-h-[400px] bg-slate-50 sm:rounded-2xl sm:shadow-md mx-auto my-4 sm:my-8 overflow-hidden flex justify-center">
          <img 
            src={imageUrl} 
            alt={worksheet.title || ""} 
            width="1200"
            height="630"
            data-pagefind-meta="image[src]"
            class="max-h-[400px] object-contain" 
          />
        </div>
    ))}
    {hideTopImage && (imageUrl || imageObj) && (
      <img src={imageUrl || (typeof imageObj === "string" ? imageObj : imageObj.src)} alt="" class="hidden" data-pagefind-meta="image[src]" />
    )}

    {
      isNewLessonType ? (
        <div class="worksheet-content" set:html={worksheet.htmlCompiled || ""} />
      ) : (
        <>
          <!-- Web Component Wrapper -->
          <tj-pocketbase-worksheet class="justify-around">
            <script type="application/json" set:html={JSON.stringify(parsedLesson).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')}
            ></script>
          </tj-pocketbase-worksheet>

          <!-- Fallback Content (Server Rendered) -->
          <div class="tj-fallback p-4 sm:p-8">
            <h1 class="text-3xl font-extrabold text-blue-600 mb-4">
              {worksheet.title}
            </h1>
            {
              worksheet.seo && (
                <p class="text-slate-600 italic mb-6 text-lg">{worksheet.seo}</p>
              )
            }
            {
              !worksheet.seo && worksheet.description && (
                <p class="text-slate-600 italic mb-6 text-lg">
                  {worksheet.description}
                </p>
              )
            }

            <div class="fallback-json-content prose-slate prose-lg max-w-none">
              <Fragment set:html={contentFallbackHtml} />
            </div>
          </div>
        </>
      )
    }

    {
      recommendations.length > 0 && (
        <Recommendations posts={recommendations} lang={currentLang} />
      )
    }
  </article>
</Layout>
<style is:global>
  @reference "../../styles/global.css";
  
  /* Standard content padding on mobile and desktop */
  .worksheet-content > *:not(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation, .tj-audio-card, .tj-file-card) {
    @apply px-4 sm:px-8 lg:px-12;
  }

  /* Add prose styling to make HTML output look good */
  .worksheet-content :where(h1) {
    @apply text-4xl font-extrabold mt-12 mb-6 text-slate-900 tracking-tight;
  }
  .worksheet-content :where(h2) {
    @apply text-3xl font-bold mt-10 mb-4 text-slate-800 tracking-tight;
  }
  .worksheet-content :where(h3) {
    @apply text-2xl font-bold mt-8 mb-4 text-slate-800;
  }
  .worksheet-content :where(h4) {
    @apply text-xl font-bold mt-6 mb-2 text-slate-800;
  }
  .worksheet-content :where(h5) {
    @apply text-lg font-bold mt-4 mb-2 text-slate-800;
  }
  .worksheet-content :where(h6) {
    @apply text-base font-bold mt-4 mb-2 text-slate-800 uppercase tracking-wide;
  }
  .worksheet-content :where(p) {
    @apply mb-4 text-slate-700 leading-relaxed;
  }
  .worksheet-content :where(ul) {
    @apply list-disc list-outside pl-6 mb-4 text-slate-700 space-y-2;
  }
  .worksheet-content :where(ol) {
    @apply list-decimal list-outside pl-6 mb-4 text-slate-700 space-y-2;
  }
  .worksheet-content :where(blockquote) {
    @apply border-l-4 border-slate-200 pl-4 my-4 italic text-slate-600;
  }
  .worksheet-content :where(a) {
    @apply text-blue-600 underline underline-offset-2 hover:text-blue-800;
  }
  .worksheet-content :is(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation) {
    @apply my-6 block w-full mx-auto;
  }

  /* Reduce top margin for the very first heading in the content */
  .worksheet-content > :first-child:is(h1, h2, h3, h4, h5, h6) {
    @apply mt-2;
  }

  /* Custom Audio Card Styles */
  .tj-audio-card {
    @apply my-8 mx-4 sm:mx-auto p-4 sm:p-6 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 max-w-2xl;
    background-image: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
  }

  .tj-audio-info {
    @apply flex items-center gap-4 mb-4;
  }

  .tj-audio-thumbnail {
    @apply w-12 h-12 sm:w-16 sm:h-16 rounded-xl object-cover shadow-sm bg-slate-100;
  }

  .tj-audio-placeholder {
    @apply w-12 h-12 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center bg-emerald-50 text-emerald-600 shadow-inner;
  }

  .tj-audio-meta {
    @apply flex-1 min-w-0;
  }

  .tj-audio-title {
    @apply block text-base sm:text-lg font-bold text-slate-800 truncate leading-tight;
  }

  .tj-audio-native {
    @apply w-full h-10 mt-1;
    /* Basic customization for supported browsers */
  }

  .tj-audio-native::-webkit-media-controls-panel {
    @apply bg-slate-50;
  }

  .tj-audio-native::-webkit-media-controls-play-button {
    @apply bg-emerald-600 rounded-full text-white;
  }

  /* Custom File Card Styles */
  .tj-file-card {
    @apply my-8 mx-4 sm:mx-auto p-4 sm:p-6 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 max-w-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4;
    background-image: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
  }

  .tj-file-info {
    @apply flex flex-row items-center gap-4 flex-1 min-w-0 w-full;
  }

  .tj-file-icon {
    @apply w-12 h-12 shrink-0 rounded-xl flex items-center justify-center bg-blue-50 text-blue-600 shadow-inner;
  }

  .tj-file-details {
    @apply flex-1 min-w-0 flex flex-col justify-center;
  }

  .tj-file-title {
    @apply block text-base sm:text-lg font-bold text-slate-800 truncate leading-tight;
  }

  .tj-file-caption {
    @apply text-sm text-slate-500 mt-1 line-clamp-2;
  }

  .tj-file-meta {
    @apply text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider;
  }

  .tj-file-download-btn {
    @apply flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors w-full sm:w-auto shrink-0 no-underline shadow-sm;
  }

  /* Hide fallbacks once components are defined */
  :is(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation):defined + .tj-fallback {
    display: none;
  }

  tj-pocketbase-worksheet {
    display: flex;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Hide fallback once component is defined */
  tj-pocketbase-worksheet:defined + .tj-fallback {
    display: none;
  }
</style>

<script is:inline>
  // Ensure the script is only loaded when component is used
  if (document.querySelector("tj-pocketbase-worksheet") && !customElements.get("tj-pocketbase-worksheet")) {
    const script = document.createElement("script");
    script.src =
      "https://language-learning-worksheets.pages.dev/wc/tj-pocketbase-worksheet.es.js";
    script.type = "module";
    script.defer = true;
    document.head.appendChild(script);
  }
</script>
