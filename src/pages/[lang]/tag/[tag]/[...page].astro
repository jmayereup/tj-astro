---
import ListingPageLayout from '../../../../layouts/ListingPageLayout.astro';
import { getAllPosts } from '../../../../lib/ghost-utils';
import { LANGUAGES, CATEGORY_FILTERS, WORKSHEET_TOPICS } from '../../../../utils/tags';
import { getPb } from '../../../../lib/pocketbase';
import { mapPbRecord } from '../../../../lib/pb-worksheet-mapper';
import TopicFilter from '../../../../components/TopicFilter.astro';


export async function getStaticPaths({ paginate }: any) {
  const allPaths: any[] = [];

  // Fetch all PocketBase worksheets once and normalize
  let allPbWorksheets: any[] = [];
  try {
    const pb = await getPb();
    const records = await pb.collection('worksheets').getFullList({ sort: '-created', filter: 'notForBlog != true' });
    allPbWorksheets = await Promise.all(records.filter((r) => !r.notForBlog).map(mapPbRecord));
  } catch (e) {
    console.warn("Failed to fetch PocketBase worksheets for tag pages", e);
  }

  for (const langObj of LANGUAGES) {
    const lang = langObj.code;
    let ghostPosts: any[] = [];
    try {
      ghostPosts = await getAllPosts({ filter: `tag:${lang}`, include: ['tags'] });
      ghostPosts = ghostPosts.map((post: any) => ({ ...post, source: 'ghost' }));
    } catch (e) {
      console.error(`Failed to fetch Ghost posts for ${lang}`, e);
    }

    const filterCategories = CATEGORY_FILTERS.filter((f: any) => f.id !== 'all');
    const worksheetTopics = WORKSHEET_TOPICS;

    // Combine standard categories and worksheet topics for routing
    const allTags = [
      ...filterCategories,
      ...worksheetTopics
    ];

      for (const category of allTags) {
      // 1. Ghost Content (match by tag slug)
      let filteredItems = ghostPosts.filter((post: any) => {
        if (category.id === 'bilingual') {
          return post.tags?.some((t: any) => t.slug === 'lbl-reader' || t.slug === 'blb');
        }
        if (category.id === 'speaking') {
          return post.tags?.some((t: any) => t.slug === 'speaking' || t.slug === 'pronunciation');
        }
        return post.tags?.some((t: any) => t.slug === category.id);
      });

      // 2. PocketBase Content
      // Check if this is a main lessonType category
      const isLessonType = ['speaking', 'worksheet', 'book', 'bilingual', 'grammar-game', 'listening'].includes(category.id);
      
      if (isLessonType) {
        let matchingPb: any[] = [];
        if (category.id === 'speaking') {
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ['information-gap', 'pronunciation'].includes(ws.lessonType)
          );
        } else if (category.id === 'book') {
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ['focused-reading', 'chapter-book'].includes(ws.lessonType)
          );
        } else if (category.id === 'bilingual') {
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ['lbl-reader'].includes(ws.lessonType)
          );
        } else if (category.id === 'grammar-game') {
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ['word-blaster', 'grammar-hearts', 'speed-review'].includes(ws.lessonType)
          );
        } else if (category.id === 'listening') {
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ['listening'].includes(ws.lessonType)
          );
        } else {
          // 'worksheet'
          matchingPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ws.lessonType === 'worksheet'
          );
        }

        // For speaking, also include PB items tagged with pronunciation
        if (category.id === 'speaking') {
          const pronunPb = allPbWorksheets.filter(
            (ws) => ws.language === lang && ws.tags?.some((t: any) => t.name.toLowerCase() === 'pronunciation')
          );
          // Avoid duplicates if any
          const existingIds = new Set(matchingPb.map(ws => ws.id));
          for (const ws of pronunPb) {
            if (!existingIds.has(ws.id)) {
              matchingPb.push(ws);
            }
          }
        }

        filteredItems = [...filteredItems, ...matchingPb];
      } else {
        // Assume it's a content topic tag (science, history, course, etc.)
        const matchingPb = allPbWorksheets.filter(
          (ws) => ws.language === lang && ws.tags?.some((t: any) => t.name.toLowerCase() === category.id.toLowerCase())
        );
        filteredItems = [...filteredItems, ...matchingPb];
      }

      // Sort combined results
      filteredItems.sort((a, b) => {
        const da = new Date(a.published_at || a.created_at || 0).getTime();
        const db = new Date(b.published_at || b.created_at || 0).getTime();
        return db - da;
      });

      const paginated = paginate(filteredItems, {
        params: { lang, tag: category.id },
        pageSize: 12,
      });

      allPaths.push(...paginated);
    }
  }

  return allPaths;
}

const { page } = Astro.props as { page: any };
const { lang, tag } = Astro.params as { lang: string; tag: string };

const titleMap: Record<string, string> = {
  french: 'French',
  german: 'German',
  spanish: 'Spanish',
  english: 'English',
  thai: 'Thai',
};

const displayLang = titleMap[lang] || lang;
const filterLabel = CATEGORY_FILTERS.find((f: any) => f.id === tag)?.label || 
                   WORKSHEET_TOPICS.find((f: any) => f.id === tag)?.label || 
                   tag;

const isWorksheetRelated = tag === 'worksheet' || WORKSHEET_TOPICS.some(t => t.id === tag);
---

<ListingPageLayout
  page={page}
  lang={lang}
  displayLang={displayLang}
  tag={tag}
  filterLabel={filterLabel}
>
  <Fragment slot="title">{displayLang + ' ' + filterLabel}</Fragment>
  
  <Fragment slot="description">
    Browse our collection of interactive {displayLang}{" "}
    {filterLabel.toLowerCase()} and language learning materials.
  </Fragment>

  {isWorksheetRelated && (
    <TopicFilter 
      slot="extra-filters" 
      currentLang={lang} 
      currentTopic={tag} 
    />
  )}

  <Fragment slot="empty-state">
    <p class="text-lg font-medium">No {displayLang} {filterLabel.toLowerCase()} found.</p>
    <p class="mt-2 opacity-80">Make sure your Ghost posts have the tag "{displayLang}".</p>
  </Fragment>
</ListingPageLayout>
