---
import Layout from '../../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import { getAllPosts } from '../../lib/ghost-utils';
import { resolveLocalizedImage } from '../../utils/assetResolver';
import { transformGhostHtml } from '../../utils/contentTransformer';
import { downloadGhostHtmlAssets } from '../../utils/downloadGhostAsset';
import { transformComponentsToScripts } from '../../utils/transformComponentsToScripts';
import { transformYouTubeEmbeds } from '../../utils/transformYouTubeEmbeds';
import { LANGUAGES } from '../../utils/tags';
import ShareButtons from '../../components/ShareButtons.astro';
import PostTags from '../../components/PostTags.astro';
import Recommendations from '../../components/Recommendations.astro';
import { getPb, fetchTeacherSubmissionUrl } from '../../lib/pocketbase';
import { mapPbRecord } from '../../lib/pb-worksheet-mapper';
import { GHOST_API_URL } from '../../lib/env';

export async function getStaticPaths() {
  const ghostPosts = await getAllPosts({ include: ['tags'] });
  
  // Fetch and normalize PB posts once for cross-source recommendations
  let allPbWorksheets: any[] = [];
  try {
    const pb = await getPb();
    const records = await pb.collection('worksheets').getFullList({ sort: '-created', filter: 'notForBlog != true' });
    allPbWorksheets = await Promise.all(records.filter((r) => !r.notForBlog).map(mapPbRecord));
  } catch (e) {
    console.warn("Failed to fetch PB worksheets for Ghost recommendations", e);
  }

  const normalizedGhost = ghostPosts.map(p => ({ ...p, type: 'gh', source: 'ghost' }));
  const allNormalized = [...normalizedGhost, ...allPbWorksheets];

  return normalizedGhost.map(post => {
    const tagSlugs = post.tags?.map((t: any) => t.slug) || [];
    const lang = tagSlugs.find((s: any) => ['english', 'french', 'german', 'spanish', 'thai'].includes(s)) || 'english';
    
    // Primary category tag (excluding language and levels)
    const categoryTag = tagSlugs.find((s: any) => 
      ['bilingual', 'lbl-reader', 'blb', 'book', 'worksheet', 'grammar-game', 'speaking', 'listening', 'pronunciation'].includes(s)
    );

    const recommendations = allNormalized
      .filter(p => {
        if (p.id === post.id || p.slug === post.slug) return false;
        
        const pTags = p.tags?.map((t: any) => t.slug || t.name?.toLowerCase()) || [];
        const sameLang = pTags.includes(lang) || p.language === lang;
        
        let sameCategory = false;
        if (categoryTag) {
          if (categoryTag === 'bilingual' || categoryTag === 'lbl-reader' || categoryTag === 'blb') {
             sameCategory = pTags.some((t: any) => ['bilingual', 'lbl-reader', 'blb'].includes(t));
          } else {
             sameCategory = pTags.includes(categoryTag) || p.lessonType === categoryTag;
          }
        }
        
        return sameLang && sameCategory;
      })
      .sort((a, b) => {
        const da = new Date(a.published_at || a.created_at || 0).getTime();
        const db = new Date(b.published_at || b.created_at || 0).getTime();
        return db - da;
      })
      .slice(0, 3);

    return {
      params: { slug: post.slug },
      props: { post, recommendations },
    };
  });
}

const { post: initialPost, recommendations = [] } = Astro.props;
const ogImage = initialPost.feature_image; // Original URL for OG
const post = { ...initialPost };

let featureImageObj: any = undefined;
if (post.feature_image) {
    const featureImageUrl = new URL(post.feature_image.startsWith('http') ? post.feature_image : `${GHOST_API_URL}${post.feature_image}`);
    let filename = featureImageUrl.pathname.split('/').pop();
    // If the pathname has no extension (e.g. Unsplash: /photo-1234?fm=jpg&...),
    // derive the extension from the `fm` query param — matching download-assets.mjs logic.
    if (filename && !filename.includes('.')) {
        const fm = featureImageUrl.searchParams.get('fm');
        const ext = fm ? `.${fm}` : '.jpg';
        filename = `${filename}${ext}`;
    }
    if (filename) {
        const resolved = await resolveLocalizedImage('gh', post.slug, filename);
        if (resolved && typeof resolved !== 'string') {
            featureImageObj = resolved;
            const optimized = await getImage({ src: resolved, width: 1200 });
            post.feature_image = optimized.src;
        } else if (resolved) {
            post.feature_image = resolved;
        } else {
            // Not found locally — fall back to the original remote URL
            post.feature_image = post.feature_image;
        }
    }
}

if (post.html) {
    const submissionUrl = await fetchTeacherSubmissionUrl();
    // 1. Replace Ghost media URLs (audio, files) with R2 URLs
    post.html = await downloadGhostHtmlAssets(post.html, post.slug, GHOST_API_URL);
    // 2. Optimize images and transform audio/file card HTML structure
    post.html = await transformGhostHtml(post.html, post.slug, GHOST_API_URL);
    post.html = transformComponentsToScripts(post.html, submissionUrl);
    post.html = transformYouTubeEmbeds(post.html);
}

// Find if any tags require a specific web component script
const tagSlugs = post.tags?.map((t: any) => t.slug) || [];
const tagClassList = tagSlugs.map((slug: string) => `tag-${slug}`).join(' ');

// Find language for highlighting navigation
let currentLang = 'english';
const supportedLangs = LANGUAGES.map(l => l.code);

for (const lang of supportedLangs) {
  if (tagSlugs.includes(lang)) {
    currentLang = lang;
    break;
  }
}

// Map of component tags to their script URLs
const componentScriptMap: Record<string, string> = {
    'tj-info-gap': 'https://scripts.teacherjake.com/tj-info-gap.js',
    'info-gap': 'https://scripts.teacherjake.com/tj-info-gap.js',
    'tj-chapter-book': 'https://scripts.teacherjake.com/tj-chapter-book.js',
    'chapter-book': 'https://scripts.teacherjake.com/tj-chapter-book.js',
    'tj-quiz-element': 'https://scripts.teacherjake.com/tj-quiz-element.js',
    'quiz-element': 'https://scripts.teacherjake.com/tj-quiz-element.js',
    'tj-speed-review': 'https://scripts.teacherjake.com/tj-speed-review.js',
    'speed-review': 'https://scripts.teacherjake.com/tj-speed-review.js',
    'tj-grammar-hearts': 'https://scripts.teacherjake.com/tj-grammar-hearts.js',
    'grammar-hearts': 'https://scripts.teacherjake.com/tj-grammar-hearts.js',
    'tj-reader': 'https://scripts.teacherjake.com/tj-reader.js',
    'lbl-reader': 'https://scripts.teacherjake.com/tj-reader.js',
    'tj-listening': 'https://scripts.teacherjake.com/tj-listening.js',
    'listening': 'https://scripts.teacherjake.com/tj-listening.js',
    'tj-pronunciation': 'https://scripts.teacherjake.com/tj-pronunciation.js',
    'pronunciation': 'https://scripts.teacherjake.com/tj-pronunciation.js',
    'tj-test': 'https://scripts.teacherjake.com/tj-test.js',
    'progressive-test': 'https://scripts.teacherjake.com/tj-test.js',
    'test-element': 'https://scripts.teacherjake.com/tj-test.js'
};

// Fallback search based on tag slugs for legacy compatibility
const tagToComponentMap: Record<string, string> = {
    'information-gap': 'tj-info-gap',
    'book': 'tj-chapter-book',
    'quiz': 'tj-quiz-element',
    'speed-review': 'tj-speed-review',
    'grammar-hearts': 'tj-grammar-hearts',
    'lbl-reader': 'tj-reader',
    'listening': 'tj-listening',
    'pronunciation': 'tj-pronunciation'
};

const scriptsToLoad = new Set<string>();

// 1. Detect components by scanning HTML
if (post.html) {
  for (const [tag, scriptUrl] of Object.entries(componentScriptMap)) {
    if (post.html.includes(`<${tag}`)) {
      scriptsToLoad.add(scriptUrl);
    }
  }
}

// 2. Fallback: Detect components by tags (keeps legacy tagging working)
for (const tagSlug of tagSlugs) {
  const componentName = tagToComponentMap[tagSlug];
  if (componentName && componentScriptMap[componentName]) {
    scriptsToLoad.add(componentScriptMap[componentName]);
  }
}

const finalScripts = Array.from(scriptsToLoad);

const tagSlugsLower = post.tags?.map((t: any) => 
  (t.slug || t.name || "").toLowerCase()
) || [];

const hideTopImage = tagSlugsLower.some((t: string) => 
  ["worksheet", "worksheets", "focused-reading", "focused reader", "lbl-reader"].includes(t)
);
---
<Layout 
  title={`${post.title} | Teacher Jake Worksheets`} 
  currentLang={currentLang}
  description={post.excerpt || post.custom_excerpt}
  image={featureImageObj || post.feature_image || ogImage}
  article={true}
>
  <Fragment slot="head">
    <!-- <link rel="stylesheet" href="https://language-learning-worksheets.pages.dev/wc/language-learning-worksheets.css"> -->
    {finalScripts.map(scriptUrl => (
      <script is:inline type="module" src={scriptUrl} defer crossorigin="anonymous"></script>
    ))}
  </Fragment>

  <article class={`relative prose pt-2 lg:prose-xl max-w-[720px] mx-auto ${tagClassList}`} data-pagefind-body>
    <h1 class="text-4xl font-extrabold mt-4 mb-6 text-slate-900 tracking-tight px-4 sm:px-0" data-pagefind-meta="title">
      {post.title}
    </h1>
    <!-- Hidden metadata for Pagefind search index -->
    <p class="sr-only">{post.excerpt || post.custom_excerpt}</p>
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center w-full mb-4 sm:mb-8 not-prose gap-2 sm:gap-0">
      <div class="order-1 sm:order-0 w-full sm:w-auto flex justify-center sm:justify-start">
        <ShareButtons title={post.title} description={post.excerpt || post.custom_excerpt} class="justify-center! sm:justify-start! m-0!" />
      </div>
      <div class="order-2 sm:order-0 w-full sm:w-auto flex items-center justify-center sm:justify-end border-t border-slate-100 sm:border-0 pt-2 sm:pt-0 gap-3">
        <PostTags post={post} lang={currentLang} />
        <button onclick="window.history.length > 1 ? window.history.back() : window.location.href = '/';" class="hidden sm:flex w-8 h-8 items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-800 transition-colors" title="Close Lesson">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <button onclick="window.history.length > 1 ? window.history.back() : window.location.href = '/';" class="sm:hidden absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-800 transition-colors z-10" title="Close Lesson">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    {!hideTopImage && (featureImageObj ? (
        <div class="w-full max-h-[400px] bg-slate-50 sm:rounded-2xl sm:shadow-md mx-auto my-4 sm:my-8 overflow-hidden flex justify-center">
          <Image 
            src={featureImageObj} 
            alt={post.title || ""} 
            width={1200}
            height={630}
            data-pagefind-meta="image[src]"
            class="max-h-[400px] object-contain" 
          />
        </div>
    ) : post.feature_image && (
        <div class="w-full max-h-[400px] bg-slate-50 sm:rounded-2xl sm:shadow-md mx-auto my-4 sm:my-8 overflow-hidden flex justify-center">
          <img 
            src={post.feature_image} 
            alt={post.title || ""} 
            width="1200"
            height="630"
            data-pagefind-meta="image[src]"
            class="max-h-[400px] object-contain" 
          />
        </div>
    ))}
    {hideTopImage && (post.feature_image || featureImageObj) && (
      <img src={post.feature_image || (typeof featureImageObj === "string" ? featureImageObj : featureImageObj.src)} alt="" class="hidden" data-pagefind-meta="image[src]" />
    )}
    
    <div class="worksheet-content" set:html={post.html} />

    {recommendations.length > 0 && <Recommendations posts={recommendations} lang={currentLang} />}
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";
  
  /* Standard content padding on mobile and desktop */
  .worksheet-content > *:not(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation, .tj-audio-card, .tj-file-card) {
    @apply px-4 sm:px-8 lg:px-12;
  }

  /* Add prose styling to make Ghost html output look good */
  .worksheet-content :where(h1) {
    @apply text-4xl font-extrabold mt-12 mb-6 text-slate-900 tracking-tight;
  }
  .worksheet-content :where(h2) {
    @apply text-3xl font-bold mt-10 mb-4 text-slate-800 tracking-tight;
  }
  .worksheet-content :where(h3) {
    @apply text-2xl font-bold mt-8 mb-4 text-slate-800;
  }
  .worksheet-content :where(h4) {
    @apply text-xl font-bold mt-6 mb-2 text-slate-800;
  }
  .worksheet-content :where(h5) {
    @apply text-lg font-bold mt-4 mb-2 text-slate-800;
  }
  .worksheet-content :where(h6) {
    @apply text-base font-bold mt-4 mb-2 text-slate-800 uppercase tracking-wide;
  }
  .worksheet-content :where(p) {
    @apply mb-4 text-slate-700 leading-relaxed;
  }
  .worksheet-content :where(ul) {
    @apply list-disc list-outside pl-6 mb-4 text-slate-700 space-y-2;
  }
  .worksheet-content :where(ol) {
    @apply list-decimal list-outside pl-6 mb-4 text-slate-700 space-y-2;
  }
  .worksheet-content :where(blockquote) {
    @apply border-l-4 border-slate-200 pl-4 my-4 italic text-slate-600;
  }
  .worksheet-content :where(a) {
    @apply text-blue-600 underline underline-offset-2 hover:text-blue-800;
  }
  .worksheet-content :is(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation) {
    @apply my-6 block w-full mx-auto;
  }

  /* Reduce top margin for the very first heading in the content */
  .worksheet-content > :first-child:is(h1, h2, h3, h4, h5, h6) {
    @apply mt-2;
  }

  /* Custom Audio Card Styles */
  .tj-audio-card {
    @apply my-8 mx-4 sm:mx-auto p-4 sm:p-6 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 max-w-2xl;
    background-image: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
  }

  .tj-audio-info {
    @apply flex items-center gap-4 mb-4;
  }

  .tj-audio-thumbnail {
    @apply w-12 h-12 sm:w-16 sm:h-16 rounded-xl object-cover shadow-sm bg-slate-100;
  }

  .tj-audio-placeholder {
    @apply w-12 h-12 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center bg-emerald-50 text-emerald-600 shadow-inner;
  }

  .tj-audio-meta {
    @apply flex-1 min-w-0;
  }

  .tj-audio-title {
    @apply block text-base sm:text-lg font-bold text-slate-800 truncate leading-tight;
  }

  .tj-audio-native {
    @apply w-full h-10 mt-1;
    /* Basic customization for supported browsers */
  }

  .tj-audio-native::-webkit-media-controls-panel {
    @apply bg-slate-50;
  }

  .tj-audio-native::-webkit-media-controls-play-button {
    @apply bg-emerald-600 rounded-full text-white;
  }

  /* Custom File Card Styles */
  .tj-file-card {
    @apply my-8 mx-4 sm:mx-auto p-4 sm:p-6 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 max-w-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4;
    background-image: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(248,250,252,0.8) 100%);
  }

  .tj-file-info {
    @apply flex flex-row items-center gap-4 flex-1 min-w-0 w-full;
  }

  .tj-file-icon {
    @apply w-12 h-12 shrink-0 rounded-xl flex items-center justify-center bg-blue-50 text-blue-600 shadow-inner;
  }

  .tj-file-details {
    @apply flex-1 min-w-0 flex flex-col justify-center;
  }

  .tj-file-title {
    @apply block text-base sm:text-lg font-bold text-slate-800 truncate leading-tight;
  }

  .tj-file-caption {
    @apply text-sm text-slate-500 mt-1 line-clamp-2;
  }

  .tj-file-meta {
    @apply text-xs font-medium text-slate-400 mt-1 uppercase tracking-wider;
  }

  .tj-file-download-btn {
    @apply flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors w-full sm:w-auto shrink-0 no-underline shadow-sm;
  }

  /* Hide fallbacks once components are defined */
  :is(tj-info-gap, tj-chapter-book, tj-quiz-element, tj-speed-review, tj-grammar-hearts, tj-reader, tj-listening, tj-pronunciation):defined + .tj-fallback {
    display: none;
  }
</style>


