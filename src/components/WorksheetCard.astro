---
import { Image } from "astro:assets";
import placeholderImg from "../assets/images/placeholder.jpg";

import { resolveLocalizedImage } from "../utils/assetResolver";

interface Props {
  post: any;
  lang: string;
}

const { post, lang } = Astro.props;

let cardImageObj: any = undefined;
if (post.feature_image) {
  if (typeof post.feature_image === "object") {
    cardImageObj = post.feature_image;
  } else if (typeof post.feature_image === "string") {
    const urlStr = post.feature_image;
    let filename = "";
    try {
      const urlObj = new URL(urlStr.startsWith("http") ? urlStr : `https://blog.teacherjake.com${urlStr}`);
      filename = urlObj.pathname.split("/").pop() || "";
      if (filename && !filename.includes(".")) {
        const fm = urlObj.searchParams.get("fm");
        filename = `${filename}${fm ? "." + fm : ".jpg"}`;
      }
    } catch {
      filename = urlStr.split("/").pop() || "";
    }
    
    if (filename) {
      const resolved = await resolveLocalizedImage(post.type === "pb" || post.source === "pocketbase" ? "pb" : "gh", post.slug || post.id, filename);
      if (resolved && typeof resolved !== "string") {
        cardImageObj = resolved;
      }
    }
  }
}

const levelTag = post.tags?.find((tag: any) =>
  ["A1", "A2", "B1", "B2"].includes(tag.name)
);

const isPb = post.type === "pb" || post.source === "pocketbase";
const href = isPb ? `/pb/${post.slug || post.id}` : `/gh/${post.slug}`;

// Activity Type Detection & Tag Normalization
const postTags = post.tags || [];
const normalizedTags = postTags.map((t: any) => {
  const name = t.name || "";
  const slug = t.slug || "";
  const lowerName = name.toLowerCase();
  const lowerSlug = slug.toLowerCase();
  return {
    ...t,
    lowerName,
    lowerSlug,
    isInternal: lowerName.startsWith("#") || lowerSlug.startsWith("hash-"),
    // Strips both # and hash- prefixes
    cleanSlug: lowerSlug.replace(/^hash-/, "").replace(/^#/, ""),
    cleanName: lowerName.replace(/^#/, "")
  };
});

const tagCleanNames = normalizedTags.map((t: any) => t.cleanName);
const tagCleanSlugs = normalizedTags.map((t: any) => t.cleanSlug);
const allCleanTags = [...tagCleanNames, ...tagCleanSlugs];

let activityType = "";
if (isPb) {
  const lessonType = (post.lessonType || "").toLowerCase();
  if (lessonType === "worksheets" || lessonType === "worksheet") activityType = "WORKSHEET";
  else if (lessonType === "information-gap") activityType = "INFORMATION GAP";
  else if (lessonType === "focused-reading" || lessonType === "focused reader") activityType = "FOCUSED READER";
  else if (lessonType === "word-blaster") activityType = "GAME";
  else if (lessonType === "lbl-reader") activityType = "LINE-BY-LINE STORY";
  else if (lessonType === "grammar-hearts") activityType = "GRAMMAR HEARTS";
  else if (lessonType === "listening") activityType = "LISTENING";
  else if (lessonType === "speed-review") activityType = "SPEED REVIEW";
  else if (lessonType === "chapter-book") activityType = "CHAPTER STORY";
  else if (lessonType === "pronunciation") activityType = "PRONUNCIATION";
  else if (lessonType === "quiz-element") activityType = "QUIZ";
} else {
  if (allCleanTags.includes("lbl-reader")) activityType = "LINE-BY-LINE STORY";
  else if (allCleanTags.includes("book") && allCleanTags.includes("blb")) activityType = "BILINGUAL STORY";
  else if (allCleanTags.includes("book")) activityType = "CHAPTER STORY";
  else if (allCleanTags.includes("pronunciation")) activityType = "PRONUNCIATION";
  else if (allCleanTags.includes("listening")) activityType = "LISTENING";
  else if (allCleanTags.includes("speaking")) activityType = "SPEAKING";
  else if (allCleanTags.includes("grammar-hearts")) activityType = "GRAMMAR HEARTS";
  else if (allCleanTags.includes("speed-review")) activityType = "SPEED REVIEW";
  else if (allCleanTags.includes("quiz")) activityType = "QUIZ";
  else if (allCleanTags.includes("course")) activityType = "Course Outline";
}
---

<a
  href={href}
  data-astro-reload
  class="group bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full"
>
  <div class="aspect-video w-full shrink-0 bg-slate-50 loading-pulse flex items-center justify-center overflow-hidden relative border-b border-slate-100">
    {cardImageObj ? (
      <Image
        src={cardImageObj}
        alt={post.title || ""}
        width={400}
        height={225}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={placeholderImg}
        alt={post.title || "Placeholder"}
        width={400}
        height={225}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="grow p-5 flex flex-col">
    <div class="flex flex-wrap items-center gap-1 mb-1 line-clamp-1">
      {levelTag && (
        <span class="text-[10px] font-black tracking-wider text-emerald-700 uppercase bg-emerald-50 px-1 py-0.5 rounded border border-emerald-100">
          {levelTag.name}
        </span>
      )}
      <div class="flex items-center gap-2">
        {(() => {
          const lowerLang = (lang || "").toLowerCase();
          const pbAllowedTags = ["history", "science", "fable", "general", "video", "m1-2", "game"];
          const ghAllowedTags = ["en-th", "en-sp", "en-fr", "en-de", "blb", "book"];
          const displayTags = normalizedTags.filter(
            (t: any) =>
              !t.isInternal &&
              !["a1", "a2", "b1", "b2", lowerLang].includes(t.cleanName) &&
              (isPb ? pbAllowedTags.includes(t.cleanName) : ghAllowedTags.includes(t.cleanSlug))
          );
          
          if (displayTags.length > 0) {
            return displayTags.map((tag: any) => (
              <span class="text-[10px] font-black tracking-wider text-emerald-700 uppercase bg-emerald-50 px-1 py-0.5 rounded border border-emerald-100">
                {tag.cleanName}
              </span>
            ));
          }

          return null;
        })()}
      </div>
    </div>
    <div class="min-h-24">
      <h2 class="font-extrabold text-blue-600 text-[1.15rem] leading-tight mb-2 group-hover:text-blue-800 transition-colors line-clamp-2">
        {post.title}
      </h2>
      <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 mb-0 grow">
        {post.custom_excerpt || post.excerpt}
      </p>
    </div>

    <div class="pt-4 mt-auto border-t border-slate-100 flex items-center justify-between">
      <span class="text-[11px] font-extrabold tracking-widest text-blue-600 uppercase line-clamp-1">
        {activityType || "Open"}
      </span>
      <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300 shadow-sm group-hover:shadow-md">
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </div>
    </div>
  </div>
</a>
