---
// CookieConsent.astro
// A premium, high-aesthetic cookie consent banner fully compliant with Google Adsense guidelines.
// Master switch to disable cookie consent banner when no cookies are active
const ENABLE_COOKIE_CONSENT = false;
---

{ENABLE_COOKIE_CONSENT && (
<div id="cookie-consent-banner" class="fixed bottom-0 left-0 right-0 md:bottom-6 md:right-6 md:left-auto md:max-w-md w-full z-50 p-4 md:p-0 transition-all duration-300 translate-y-20 opacity-0 pointer-events-none">
  <div class="bg-white/90 backdrop-blur-xl border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.15)] rounded-2xl md:rounded-2xl p-5 md:p-6 text-slate-700">
    <div class="flex items-start gap-3.5">
      <div class="p-2 bg-emerald-50 rounded-xl text-emerald-700 shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6 animate-pulse">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-slate-900 tracking-tight mb-1">Cookie Preferences</h3>
        <p class="text-sm text-slate-500 leading-relaxed">
          We use cookies to improve your learning experience, analyze traffic, and show relevant Google Ads. Read our <a href="/privacy" class="text-emerald-700 font-semibold hover:underline">Privacy Policy</a> to learn more.
        </p>
      </div>
    </div>

    <!-- Granular Controls Accordion (Hidden by default) -->
    <div id="cookie-details" class="mt-5 pt-4 border-t border-slate-100 hidden space-y-4">
      <!-- Category: Necessary -->
      <div class="flex items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-semibold text-slate-800">Essential Cookies</h4>
          <p class="text-xs text-slate-400">Required for the site to function properly. Cannot be disabled.</p>
        </div>
        <div class="relative inline-flex items-center">
          <input type="checkbox" checked disabled class="sr-only peer" />
          <div class="w-11 h-6 bg-slate-200 rounded-full peer-checked:bg-emerald-600/50 after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full peer-checked:after:bg-emerald-700 peer-checked:after:border-emerald-600 opacity-60"></div>
        </div>
      </div>

      <!-- Category: Analytics -->
      <div class="flex items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-semibold text-slate-800">Analytics</h4>
          <p class="text-xs text-slate-400">Help us understand how visitors interact with worksheets.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="consent-analytics" checked class="sr-only peer" />
          <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-focus:ring-2 peer-focus:ring-emerald-300 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-700"></div>
        </label>
      </div>

      <!-- Category: Marketing / Ads -->
      <div class="flex items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-semibold text-slate-800">Personalized Ads</h4>
          <p class="text-xs text-slate-400">Enables Google to personalize and display ads on this site.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="consent-marketing" checked class="sr-only peer" />
          <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-focus:ring-2 peer-focus:ring-emerald-300 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-700"></div>
        </label>
      </div>
    </div>

    <!-- Buttons -->
    <div class="mt-6 flex flex-wrap items-center justify-end gap-3 text-sm">
      <button id="btn-cookie-settings" class="px-3.5 py-2 font-medium text-slate-500 hover:text-slate-800 transition-all hover:bg-slate-50 rounded-xl cursor-pointer">
        Customize
      </button>
      <button id="btn-cookie-decline" class="px-4 py-2 font-medium border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-all rounded-xl cursor-pointer">
        Only Necessary
      </button>
      <button id="btn-cookie-accept" class="px-5 py-2 font-semibold bg-emerald-700 hover:bg-emerald-800 text-white shadow-sm hover:shadow transition-all hover:-translate-y-px rounded-xl cursor-pointer">
        Accept All
      </button>
      <button id="btn-cookie-save" class="px-5 py-2 font-semibold bg-emerald-700 hover:bg-emerald-800 text-white shadow-sm hover:shadow transition-all hover:-translate-y-px rounded-xl hidden cursor-pointer">
        Save Selection
      </button>
    </div>
  </div>
</div>

<!-- Tiny Floating Trigger is removed to keep layout clean, opened via privacy policy link instead -->

<script is:inline>
  (() => {
    const STORAGE_KEY = 'tj_cookie_consent';

    function initConsentBanner() {
      const banner = document.getElementById('cookie-consent-banner');
      
      const btnAccept = document.getElementById('btn-cookie-accept');
      const btnDecline = document.getElementById('btn-cookie-decline');
      const btnSettings = document.getElementById('btn-cookie-settings');
      const btnSave = document.getElementById('btn-cookie-save');
      const details = document.getElementById('cookie-details');
      
      const inputAnalytics = document.getElementById('consent-analytics');
      const inputMarketing = document.getElementById('consent-marketing');

      if (!banner) return;

      const savedConsent = localStorage.getItem(STORAGE_KEY);

      // Show/Hide Helpers
      function showBanner() {
        banner.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      function hideBanner() {
        banner.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }

      function openConsentSettings() {
        if (details) details.classList.remove('hidden');
        if (btnSettings) btnSettings.classList.add('hidden');
        if (btnDecline) btnDecline.classList.add('hidden');
        if (btnAccept) btnAccept.classList.add('hidden');
        if (btnSave) btnSave.classList.remove('hidden');
        showBanner();
      }

      function savePreferences(consentObj) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(consentObj));
        
        // Dispatch event so third party scripts can listen
        const event = new CustomEvent('cookieConsentChanged', { detail: consentObj });
        document.dispatchEvent(event);

        // Configure Google AdSense Consent and load script dynamically
        const requestNPA = consentObj.marketing ? 0 : 1;
        (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = requestNPA;

        if (typeof window.loadGoogleAds === 'function') {
          window.loadGoogleAds(requestNPA);
        }
        
        hideBanner();
      }

      // Action Handlers
      if (btnAccept) {
        btnAccept.addEventListener('click', () => {
          savePreferences({ necessary: true, analytics: true, marketing: true });
        });
      }

      if (btnDecline) {
        btnDecline.addEventListener('click', () => {
          savePreferences({ necessary: true, analytics: false, marketing: false });
        });
      }

      if (btnSettings) {
        btnSettings.addEventListener('click', () => {
          details.classList.toggle('hidden');
          btnSettings.classList.toggle('hidden');
          btnDecline.classList.toggle('hidden');
          btnAccept.classList.toggle('hidden');
          btnSave.classList.toggle('hidden');
        });
      }

      if (btnSave) {
        btnSave.addEventListener('click', () => {
          savePreferences({
            necessary: true,
            analytics: inputAnalytics ? inputAnalytics.checked : true,
            marketing: inputMarketing ? inputMarketing.checked : true
          });
        });
      }

      // Add click event listeners to any elements with the class 'open-cookie-settings'
      const openSettingsLinks = document.querySelectorAll('.open-cookie-settings');
      openSettingsLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          openConsentSettings();
        });
      });

      // Check existing consent status
      if (!savedConsent) {
        setTimeout(showBanner, 800); // Small premium delay
      } else {
        try {
          const consent = JSON.parse(savedConsent);
          if (inputAnalytics) inputAnalytics.checked = consent.analytics ?? true;
          if (inputMarketing) inputMarketing.checked = consent.marketing ?? true;
          
          // Set initial adsbygoogle consent state
          if (consent.marketing) {
            (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 0;
          } else {
            (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 1;
          }
        } catch (e) {
          localStorage.removeItem(STORAGE_KEY);
          setTimeout(showBanner, 800);
        }
      }
    }

    // Initialize on page load
    initConsentBanner();

    // Support Astro Page transitions / ClientRouter
    document.addEventListener('astro:page-load', initConsentBanner);
  })();
</script>
)}
