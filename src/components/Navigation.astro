---
import { Image } from 'astro:assets';
import logoImage from '../assets/tj-logo-big-brighter.png';
import TagFilter from './TagFilter.astro';
import Search from './Search.astro';

const languages = [
  { code: 'english', label: 'English' },
  { code: 'french', label: 'French' },
  { code: 'german', label: 'German' },
  { code: 'spanish', label: 'Spanish' },
  { code: 'thai', label: 'Thai' }
];

const { currentLang = 'english', currentTag } = Astro.props;
---
<nav class="bg-[#005522] text-white py-2 px-4 shadow-sm top-0 z-100" transition:name="navbar">
  <div class="container mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row items-center justify-between gap-x-6 gap-y-2">
      
      {/* Left Group: Logo + Tags (Side-by-side on mobile) */}
      <div class="flex flex-col md:flex-row items-center gap-2 w-full md:w-auto self-start md:self-center">
        {/* Logo - Anchored width on desktop, flexible on mobile */}
        <div class="shrink-0 flex items-center justify-center self-stretch py-1">
          <a href="/" class="flex items-center h-full" title="Home">
            <Image 
              src={logoImage} 
              alt="Teacher Jake Logo" 
              class="h-20 md:h-10 w-auto rounded shadow-inner object-contain"
              width={80}
              height={80}
              transition:name="navbar-logo" 
            />
          </a>
        </div>

        {/* Tag Filters - Grow to fill space next to logo */}
        <div class="grow overflow-hidden">
          <TagFilter currentLang={currentLang} currentTag={currentTag} />
        </div>
      </div>

      {/* Right Group: Search and Language */}
      <div class="flex items-center gap-3 w-[400px] justify-center md:justify-end pb-2 md:pb-0">
        <div class="max-w-[340px]">
          <Search />
        </div>

        {/* Language Dropdown */}
        <div class="relative group">
          <details class="language-dropdown">
            <summary class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 transition-all cursor-pointer list-none" title="Change Language">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </summary>
            <div class="absolute right-0 mt-2 w-40 bg-white rounded-xl shadow-xl border border-slate-200 overflow-hidden z-110 py-1">
              {languages.map(lang => (
                <a 
                  href={`/${lang.code}`}
                  data-astro-reload
                  class={`flex items-center px-4 py-2.5 text-sm font-medium transition-colors ${
                    currentLang === lang.code 
                      ? 'bg-emerald-50 text-[#005522]' 
                      : 'text-slate-700 hover:bg-slate-50'
                  }`}
                >
                  <span class={`w-2 h-2 rounded-full mr-3 ${currentLang === lang.code ? 'bg-[#005522]' : 'bg-transparent'}`}></span>
                  {lang.label}
                </a>
              ))}
            </div>
          </details>
        </div>

        {/* Help & Links Dropdown */}
        <div class="relative group">
          <details class="help-dropdown">
            <summary class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 transition-all cursor-pointer list-none" title="Help & Policies">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </summary>
            <div class="absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-slate-200 overflow-hidden z-110 p-2 text-slate-800 text-sm">
              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 mb-1">
                Footer Policies & Info
              </div>
              <a href="/privacy" class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-slate-100 font-medium transition-colors text-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Privacy Policy
              </a>
              <a href="/terms" class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-slate-100 font-medium transition-colors text-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Terms of Service
              </a>
              <a href="/ai-disclaimer" class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-slate-100 font-medium transition-colors text-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                AI Disclaimer
              </a>
              <a href="/contact" class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-slate-100 font-medium transition-colors text-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Contact
              </a>

              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-t border-slate-100 my-1">
                Subdomains & Apps
              </div>
              <a href="https://dahoot.teacherjake.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-emerald-50 text-emerald-900 font-medium transition-colors">
                <span>Dahoot (Gamified)</span>
                <span class="text-xs text-emerald-600 font-bold">↗</span>
              </a>
              <a href="https://books.teacherjake.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-emerald-50 text-emerald-900 font-medium transition-colors">
                <span>Teacher Jake Books</span>
                <span class="text-xs text-emerald-600 font-bold">↗</span>
              </a>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  // Register the click-outside listener only once (guard against accumulation across view transitions)
  if (!window.__navClickListenerAttached) {
    window.__navClickListenerAttached = true;
    document.addEventListener('click', (event) => {
      ['.language-dropdown', '.help-dropdown'].forEach(selector => {
        const details = document.querySelector(selector);
        if (details && !details.contains(event.target)) {
          details.removeAttribute('open');
        }
      });
    });
  }

  // Close dropdowns on each page transition
  document.addEventListener('astro:page-load', () => {
    ['.language-dropdown', '.help-dropdown'].forEach(selector => {
      const details = document.querySelector(selector);
      if (details) {
        details.removeAttribute('open');
      }
    });
  });
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Remove default details arrow */
  .language-dropdown summary::-webkit-details-marker,
  .help-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .language-dropdown summary,
  .help-dropdown summary {
    list-style: none;
  }
</style>
